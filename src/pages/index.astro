---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import TagList from '../components/home/TagList.astro';
import ArticleList from '../components/home/ArticleList.astro';

const title = 'ben7sys';
const description =
  'Technische Einordnung, belastbare Entscheidungen und praxistaugliche Werkzeuge für nachhaltige Systeme.';

const docs = await getCollection('docs');
const articles = docs
  .filter(
    ({ data }) =>
      data.doctype === 'article' &&
      data.status === 'stable' &&
      data.publishedAt,
  )
  .sort(
    (a, b) =>
      (b.data.publishedAt?.getTime() ?? 0) -
      (a.data.publishedAt?.getTime() ?? 0),
  )
  .map(({ id, data }) => ({
    title: data.title,
    description: data.description,
    href: `/${id.replace(/\/index$/, '')}/`,
    publishedAt: data.publishedAt,
    tags: data.tags,
  }));

const tags = [...new Set(articles.flatMap((article) => article.tags ?? []))].sort(
  (a, b) => a.localeCompare(b, 'de'),
);
---

<StarlightPage
  frontmatter={{
    title,
    description,
    pagefind: false,
    template: 'splash',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <main class="home-shell">
    <HomeHeader title={title} description={description} />
    <TagList tags={tags} />
    <ArticleList articles={articles} />
  </main>
</StarlightPage>
